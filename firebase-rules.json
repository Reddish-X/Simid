{
  "rules": {
    "chat": {
      ".read": true,
      ".write": true,
      ".indexOn": ["ts"],
      "$msg": {
        ".validate": "newData.child('text').isString() && newData.child('text').val().length <= 50 && newData.child('name').isString() && newData.child('name').val().length <= 16"
      }
    },
    "note": {
      ".read": true,
      "main": {
        ".write": "newData.child('key').val() === 'simid-secret' || data.exists() && data.child('key').val() === 'simid-secret'",
        ".validate": "newData.child('text').isString() && newData.child('text').val().length <= 600"
      }
    },
    "uploads": {
      ".read": true,
      ".indexOn": ["ts"],
      "$item": {
        ".write": "newData.child('key').val() === 'simid-secret' || data.exists() && data.child('key').val() === 'simid-secret'",
        ".validate": "newData.child('url').isString() && newData.child('url').val().length < 2000"
      }
    },
    "game": {
      "players": {
        ".read": true,
        ".write": true,
        "$pid": {
          ".validate": "newData.child('x').isNumber() && newData.child('z').isNumber() && newData.child('n').isString() && newData.child('n').val().length <= 20"
        }
      },
      "hits": {
        ".read": true,
        ".write": true,
        "$hit": {
          ".validate": "newData.child('dmg').isNumber() && newData.child('to').isString()"
        }
      }
    }
  }
}
